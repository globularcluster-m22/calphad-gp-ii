go da
sw USER /Users/maedhros/calphad-gp2/db/Fe-Cu.TDB
d-sys Fe Cu
get
go p-3
s-c t=1800 p=1e5 n=1 x(cu)=0.5
c-e
s-a-v 1 x(cu) 0 1 0.005
s-a-v 2 t 1000 1900 2
map
post
s-d-a x m-f cu
s-d-a y t-k
set-title Fe-Cu phase diagram
add-label-text 0.1 1800 N Peritectic L+BCC=FCC (1760 K)
add-label-text 0.5 1390 N 2nd peritectic L+FCC(Fe)=FCC(Cu) (1369 K)
plot
back

go p-3
s-c t=1900
s-a-v 1 x(cu) 0 1 0.01
step one_phase_at_time
post
s-d-a x m-f cu
s-d-a y gm(*)
*
set-title Fe-Cu GM(*) 1900 K
plot
back

